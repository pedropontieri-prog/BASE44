{
  "name": "Psychologist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "ID do usu\u00e1rio vinculado"
    },
    "full_name": {
      "type": "string",
      "title": "Nome completo"
    },
    "professional_name": {
      "type": "string",
      "title": "Nome profissional"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "title": "Foto do profissional"
    },
    "video_url": {
      "type": "string",
      "format": "uri",
      "title": "V\u00eddeo de apresenta\u00e7\u00e3o"
    },
    "video_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "title": "Status do v\u00eddeo"
    },
    "crp_number": {
      "type": "string",
      "title": "N\u00famero do CRP"
    },
    "crp_region": {
      "type": "string",
      "title": "Regi\u00e3o do CRP"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "approved",
        "needs_adjustments",
        "rejected"
      ],
      "default": "pending",
      "title": "Status de verifica\u00e7\u00e3o"
    },
    "city": {
      "type": "string",
      "title": "Cidade"
    },
    "state": {
      "type": "string",
      "title": "Estado"
    },
    "about": {
      "type": "string",
      "title": "Sobre mim"
    },
    "education": {
      "type": "string",
      "title": "Forma\u00e7\u00e3o acad\u00eamica"
    },
    "institution": {
      "type": "string",
      "title": "Institui\u00e7\u00e3o"
    },
    "graduation_year": {
      "type": "string",
      "title": "Ano de forma\u00e7\u00e3o"
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Especializa\u00e7\u00f5es"
    },
    "approaches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Abordagens terap\u00eauticas"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Especialidades"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "P\u00fablico atendido"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Temas de atua\u00e7\u00e3o"
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "online",
          "in_person"
        ]
      },
      "title": "Modalidades de atendimento"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Idiomas"
    },
    "experience": {
      "type": "string",
      "title": "Experi\u00eancia profissional"
    },
    "price": {
      "type": "number",
      "title": "Valor da sess\u00e3o"
    },
    "session_duration": {
      "type": "number",
      "default": 50,
      "title": "Dura\u00e7\u00e3o da sess\u00e3o (min)"
    },
    "available_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Dias dispon\u00edveis"
    },
    "available_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hor\u00e1rios dispon\u00edveis"
    },
    "min_notice_hours": {
      "type": "number",
      "default": 2,
      "title": "Anteced\u00eancia m\u00ednima (h)"
    },
    "timezone": {
      "type": "string",
      "default": "America/Sao_Paulo",
      "title": "Fuso hor\u00e1rio"
    },
    "cancellation_policy": {
      "type": "string",
      "title": "Pol\u00edtica de cancelamento"
    },
    "address": {
      "type": "string",
      "title": "Endere\u00e7o de atendimento presencial"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "E-mail profissional"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "gender": {
      "type": "string",
      "title": "G\u00eanero (opcional)"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "title": "Avalia\u00e7\u00e3o m\u00e9dia"
    }
  },
  "required": [
    "full_name",
    "crp_number"
  ]
}
